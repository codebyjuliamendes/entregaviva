# Copy to .env and adjust. Every variable is optional; defaults shown.

# HTTP listen port and host (empty host = all interfaces).
PORT=3003
HOST=

# SQLite database file (created with its directory if missing).
DATABASE_PATH=data/orders.sqlite

# debug | info | warn | error
LOG_LEVEL=info

# Insert demo orders when the database is empty.
SEED_DEMO=true

# Protects the operations panel (/, /app.js, /api/orders*, /api/events) with
# HTTP Basic auth. Empty disables it. Use 12+ characters in production.
OPERATOR_USER=operacao
OPERATOR_PASSWORD=

# Set to true only behind a reverse proxy that sets X-Forwarded-For/-Proto.
TRUST_PROXY=false

# SSE heartbeat interval and maximum simultaneous streams.
SSE_HEARTBEAT=20s
SSE_MAX_CLIENTS=500

# Public tracking requests per IP per minute (0 disables the limit).
TRACK_RATE_LIMIT=60

# Time allowed for in-flight requests on SIGTERM.
SHUTDOWN_TIMEOUT=10s
